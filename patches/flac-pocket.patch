diff --git a/src/pocket_external.rs b/src/pocket_external.rs
new file mode 100644
index 0000000..1dedd3d
--- /dev/null
+++ b/src/pocket_external.rs
@@ -0,0 +1,285 @@
+use std::{collections::HashSet, net::{IpAddr, SocketAddr}, time::Duration};
+
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use url::{Host, Url};
+
+const MAX_SOURCES: usize = 6;
+const MAX_JSON: usize = 512 * 1024;
+static UPDATE: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+
+#[derive(Clone, Deserialize, Serialize)]
+pub struct Source {
+    pub id: String,
+    pub name: String,
+    pub base: String,
+}
+
+pub fn sources() -> Vec<Source> {
+    let path = crate::storage::storage_path("pocket-sources.json");
+    if let Ok(raw) = std::fs::read_to_string(path) {
+        return serde_json::from_str::<Vec<Source>>(&raw).unwrap_or_default()
+            .into_iter().take(MAX_SOURCES).collect();
+    }
+    crate::storage::env("POCKET_MUSIC_SOURCES")
+        .and_then(|raw| serde_json::from_str::<Vec<String>>(&raw).ok())
+        .unwrap_or_default()
+        .iter()
+        .filter_map(|url| normalize(url).ok())
+        .map(|base| Source {
+            id: source_id(base.as_str()),
+            name: base.host_str().unwrap_or("External addon").to_string(),
+            base: base.to_string(),
+        })
+        .take(MAX_SOURCES).collect()
+}
+
+fn save(sources: &[Source]) -> Result<(), &'static str> {
+    let path = crate::storage::storage_path("pocket-sources.json");
+    let pending = path.with_extension("new");
+    let data = serde_json::to_vec(sources).map_err(|_| "Could not encode sources.")?;
+    std::fs::write(&pending, data).and_then(|()| std::fs::rename(pending, path))
+        .map_err(|_| "Could not save sources.")
+}
+
+fn parse_https(raw: &str) -> Option<Url> {
+    let url = Url::parse(raw).ok()?;
+    (url.scheme() == "https" && url.port_or_known_default() == Some(443)
+        && url.host().is_some() && url.username().is_empty() && url.password().is_none())
+        .then_some(url)
+}
+
+fn normalize(raw: &str) -> Result<Url, &'static str> {
+    let mut base = parse_https(raw.trim()).ok_or("Enter a public HTTPS addon URL.")?;
+    if base.query().is_some() || base.fragment().is_some() {
+        return Err("Use an addon URL without a query string or fragment.");
+    }
+    {
+        let mut segments = base.path_segments_mut().map_err(|_| "Invalid addon URL.")?;
+        segments.pop_if_empty();
+    }
+    if base.path().ends_with("/manifest.json") {
+        base.path_segments_mut().map_err(|_| "Invalid addon URL.")?.pop();
+    }
+    Ok(base)
+}
+
+fn source_id(raw: &str) -> String {
+    hex::encode(&Sha256::digest(raw.as_bytes())[..12])
+}
+
+fn public_ip(ip: IpAddr) -> bool {
+    if !crate::auth::is_public_ip(&ip) {
+        return false;
+    }
+    match ip {
+        IpAddr::V4(ip) => {
+            let [a, b, c, _] = ip.octets();
+            a < 224 && !(a == 192 && (b == 0 || (b == 88 && c == 99)))
+                && !(a == 198 && matches!(b, 18 | 19))
+                && !ip.is_documentation()
+        }
+        IpAddr::V6(ip) => {
+            let s = ip.segments();
+            s[0] & 0xe000 == 0x2000 && s[0] != 0x2002
+                && !(s[0] == 0x2001 && (s[1] <= 0x1ff || s[1] == 0xdb8))
+        }
+    }
+}
+
+async fn target(url: &Url) -> Option<(String, Vec<SocketAddr>)> {
+    let hostname = url.host_str()?.to_string();
+    let ips: Vec<_> = match url.host()? {
+        Host::Domain(domain) => tokio::net::lookup_host((domain, 443)).await.ok()?.collect(),
+        Host::Ipv4(ip) => vec![SocketAddr::new(IpAddr::V4(ip), 443)],
+        Host::Ipv6(ip) => vec![SocketAddr::new(IpAddr::V6(ip), 443)],
+    };
+    if ips.is_empty() || !ips.iter().all(|addr| public_ip(addr.ip())) {
+        return None;
+    }
+    Some((hostname, ips))
+}
+
+fn endpoint(base: &Url, segments: &[&str]) -> Option<Url> {
+    let mut url = base.clone();
+    {
+        let mut path = url.path_segments_mut().ok()?;
+        path.pop_if_empty().extend(segments.iter().copied());
+    }
+    Some(url)
+}
+
+async fn get_json(url: Url) -> Option<Value> {
+    tokio::time::timeout(Duration::from_secs(6), async {
+        let (host, addrs) = target(&url).await?;
+        let client = reqwest::Client::builder().no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .resolve_to_addrs(&host, &addrs).build().ok()?;
+        let mut response = client.get(url).header("Accept", "application/json")
+            .send().await.ok()?.error_for_status().ok()?;
+        let mut data = Vec::new();
+        while let Some(chunk) = response.chunk().await.ok()? {
+            if data.len() + chunk.len() > MAX_JSON {
+                return None;
+            }
+            data.extend_from_slice(&chunk);
+        }
+        serde_json::from_slice(&data).ok()
+    }).await.ok().flatten()
+}
+
+pub async fn add(raw: &str) -> Result<Source, String> {
+    let base = normalize(raw)?;
+    let url = endpoint(&base, &["manifest.json"]).ok_or("Invalid addon URL.")?;
+    let manifest = get_json(url).await.ok_or("Couldn't read the addon's manifest over public HTTPS.")?;
+    let info = crate::music_upstreams::read_manifest(&manifest)?;
+    if info.id == "io.github.bhavishyadalal.flacpocket"
+        || !["search", "stream"].iter().all(|required| info.resources.iter().any(|value| value == required))
+    {
+        return Err("Choose a music addon that supplies search and stream.".into());
+    }
+    let mut url = endpoint(&base, &["search"]).ok_or("Invalid search endpoint.")?;
+    url.query_pairs_mut().append_pair("q","music").append_pair("limit","1");
+    let sample = get_json(url).await;
+    if sample.as_ref().and_then(|body| body["tracks"].as_array()).is_none() {
+        return Err("This addon did not return a compatible music search response.".into());
+    }
+    let source = Source {
+        id: source_id(base.as_str()),
+        name: info.name.chars().take(80).collect(),
+        base: base.to_string(),
+    };
+    let _guard = UPDATE.lock().await;
+    let mut list = sources();
+    if let Some(row) = list.iter_mut().find(|row| row.id == source.id) {
+        *row = source.clone();
+    } else {
+        if list.len() >= MAX_SOURCES { return Err("Remove a source before adding another.".into()); }
+        list.push(source.clone());
+    }
+    save(&list)?;
+    Ok(source)
+}
+
+pub async fn remove(id: &str) -> Result<(), &'static str> {
+    let _guard = UPDATE.lock().await;
+    let mut list = sources();
+    list.retain(|source| source.id != id);
+    save(&list)
+}
+
+pub fn public_sources() -> Vec<Value> {
+    sources().into_iter().map(|source| json!({"id":source.id,"name":source.name})).collect()
+}
+
+pub fn settings_snapshot() -> Value {
+    let list = sources();
+    let urls: Vec<_> = list.iter().map(|source| &source.base).collect();
+    let items: Vec<_> = list.iter().map(|source| json!({"id":source.id, "name":source.name})).collect();
+    json!({"sources": items, "renderValue": serde_json::to_string(&urls).unwrap_or_default()})
+}
+
+fn requested_quality(value: &str) -> String {
+    if value.is_empty() { "LOSSLESS".to_string() } else { value.to_ascii_uppercase() }
+}
+
+fn upstream_track(source: &Source, raw: &Value) -> Option<Value> {
+    let raw_id = raw.get("id").or_else(|| raw.get("trackId"))?;
+    let id = raw_id.as_str().map(str::to_owned).or_else(|| raw_id.as_u64().map(|n| n.to_string()))?;
+    let title: String = raw.get("title")?.as_str()?.trim().chars().take(180).collect();
+    if !usable_id(&id) || title.is_empty() { return None; }
+    let mut track = json!({
+        "id": format!("px.{}.{}", source.id, crate::fileid::base64url_encode(id.as_bytes())),
+        "title": title, "sourceId": source.id, "sourceName": source.name
+    });
+    for field in ["artist", "album", "format", "audioQuality"] {
+        if let Some(value) = raw[field].as_str() {
+            track[field] = json!(value.chars().take(180).collect::<String>());
+        }
+    }
+    if let Some(art) = raw["artworkURL"].as_str().and_then(parse_https) {
+        track["artworkURL"] = json!(art.as_str());
+    }
+    for field in ["duration", "durationMs"] {
+        if let Some(value) = raw[field].as_u64() { track[field] = json!(value); }
+    }
+    Some(track)
+}
+
+fn usable_id(id: &str) -> bool {
+    !id.is_empty() && id.len() <= 256 && id != "." && id != ".."
+        && !id.chars().any(char::is_control)
+}
+
+pub async fn search(query: &str, quality: &str, only: &str) -> (Vec<Value>, bool) {
+    if query.trim().is_empty() || only == "pencari" { return (vec![], false); }
+    let mut ids = HashSet::new();
+    let pending = sources().into_iter().filter(|source| only.is_empty() || only == source.id)
+        .filter(|source| ids.insert(source.id.clone()))
+        .map(|source| async move {
+            let mut url = endpoint(&normalize(&source.base).ok()?, &["search"])?;
+            url.query_pairs_mut().append_pair("q", query).append_pair("quality", &requested_quality(quality));
+            let data = get_json(url).await?;
+            Some(data["tracks"].as_array()?.iter().take(18)
+                .filter_map(|track| upstream_track(&source, track)).collect::<Vec<_>>())
+        });
+    let mut tracks = Vec::new();
+    let mut partial = false;
+    for result in futures_util::future::join_all(pending).await {
+        match result { Some(rows) => tracks.extend(rows), None => partial = true }
+    }
+    (tracks, partial)
+}
+
+pub async fn stream(id: &str, quality: &str) -> Option<Value> {
+    let (source_id, encoded) = id.strip_prefix("px.")?.split_once('.')?;
+    if encoded.len() > 342 { return None; }
+    let raw = String::from_utf8(crate::fileid::base64url_decode(encoded)).ok()?;
+    if !usable_id(&raw) { return None; }
+    let source = sources().into_iter().find(|row| row.id == source_id)?;
+    let mut url = endpoint(&normalize(&source.base).ok()?, &["stream", &raw])?;
+    url.query_pairs_mut().append_pair("quality", &requested_quality(quality));
+    let data = get_json(url).await?;
+    if data["encrypted"].as_bool() == Some(true) { return None; }
+    let url = parse_https(data["url"].as_str()?)?;
+    tokio::time::timeout(Duration::from_secs(2), target(&url)).await.ok()??;
+    let format = data["format"].as_str().unwrap_or("");
+    let mime = data["mimeType"].as_str().unwrap_or("");
+    if (!format.is_empty() && !crate::music::is_audio(format))
+        || (!mime.is_empty() && !mime.starts_with("audio/"))
+    { return None; }
+    Some(json!({"url":url.as_str(),"format":format,"mimeType":mime,"encrypted":false}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn appends_endpoints_without_leaving_source_prefix() {
+        let base = normalize("https://example.com/private/manifest.json").unwrap();
+        assert_eq!(endpoint(&base, &["stream","ABC/123"]).unwrap().path(), "/private/stream/ABC%2F123");
+        assert!(normalize("http://example.com").is_err());
+        assert!(normalize("https://user@example.com/").is_err());
+        assert!(normalize("https://example.com:8443").is_err());
+        assert!(!usable_id(".."));
+    }
+
+    #[test]
+    fn refuses_nonpublic_destinations() {
+        for ip in ["127.0.0.1", "169.254.169.254", "192.168.0.1", "::ffff:127.0.0.1", "2001:db8::1", "224.0.0.1"] {
+            assert!(!public_ip(ip.parse().unwrap()), "{ip}");
+        }
+        assert!(public_ip("8.8.8.8".parse().unwrap()));
+    }
+
+    #[test]
+    fn labels_external_tracks_without_exposing_the_source_link() {
+        let source = Source { id:"test".into(), name:"Example".into(), base:"https://example.com/private".into() };
+        let row = upstream_track(&source, &json!({"id":123,"title":"Song","artist":"Artist","url":"https://example.com/private"})).unwrap();
+        assert_eq!(row["id"], "px.test.MTIz");
+        assert_eq!(row["sourceName"], "Example");
+        assert!(row.get("url").is_none());
+    }
+}
