+}
+
+/// Validate the entire path before handing it to the shared download handler.
+pub fn signed_music_download(path: &str, now: i64) -> Option<String> {
+    let (signature, signed) = path.strip_prefix("/m/audio/")?.split_once('/')?;
+    let (expires, file) = signed.split_once('/')?;
+    let (payload, filename) = file.split_once('/')?;
+    if expires.parse::<i64>().ok()? <= now || payload.is_empty() || filename.is_empty() {
+        return None;
+    }
+    let bytes = crate::fileid::base64url_decode(signature);
+    let signature = ed25519_dalek::Signature::from_slice(&bytes).ok()?;
+    music_download_key()
+        .verifying_key()
+        .verify_strict(signed.as_bytes(), &signature)
+        .ok()?;
+    Some(format!("/api/download/{file}"))
+}
