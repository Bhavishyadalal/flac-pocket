+/// Resolve a short music URL only after checking its explicit token. The
+/// dashboard's LAN and cookie rules do not authorize this URL by themselves.
+pub fn pocket_music_path(path: &str) -> Option<String> {
+    let (token, tail) = pocket_prefix(path)?;
+    auth_valid_tokens()
+        .iter()
+        .any(|expected| ct_eq(expected, &token))
+        .then(|| format!("/music{}", tail))
+}
+
