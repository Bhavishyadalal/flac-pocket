+fn public_pocket_music_path(path: &str) -> Option<&str> {
+    let route = path.strip_prefix("/m/")?;
+    let endpoint = route.split('/').next()?;
+    matches!(endpoint, "manifest.json" | "search" | "catalog" | "meta" | "artist" | "album" | "playlist" | "stream" | "play")
+        .then_some(route)
+}
+
+fn pocket_download_url(base_url: &str, payload: &Value, file_name: &str) -> String {
+    // Native players can reuse this URL for Range requests and seeking.
+    let expires = crate::storage::now() + 24 * 60 * 60;
+    let encoded = crate::fileid::base64url_encode(payload.to_string().as_bytes());
+    let filename = urlencode_component(file_name);
+    let signed = format!("{expires}/{encoded}/{filename}");
+    let signature = crate::auth::sign_music_download(&signed);
+    format!("{}/m/audio/{signature}/{signed}", rtrim(base_url))
+}
