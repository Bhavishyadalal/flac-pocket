+fn music_extension(name: &str, mime: &str, file_type: &str) -> Option<String> {
+    if let Some((_, ext)) = name.rsplit_once('.') {
+        let ext = ext.to_ascii_lowercase();
+        if crate::music::is_audio(&ext) {
+            return Some(ext);
+        }
+    }
+    [mime, file_type].into_iter().find_map(|value| {
+        Some(match value.split(';').next()?.trim().to_ascii_lowercase().as_str() {
+            "audio/flac" | "audio/x-flac" => "flac",
+            "audio/mpeg" | "audio/mp3" => "mp3",
+            "audio/mp4" | "audio/x-m4a" => "m4a",
+            "audio/aac" => "aac",
+            "audio/wav" | "audio/x-wav" => "wav",
+            "audio/ogg" => "ogg",
+            "audio/opus" => "opus",
+            _ => return None,
+        }.to_string())
+    })
+}
+
+#[cfg(test)]
+#[test]
+fn music_extension_uses_audio_metadata_instead_of_guessing_mp3() {
+    assert_eq!(music_extension("Real track.FLAC", "application/octet-stream", "").as_deref(), Some("flac"));
+    assert_eq!(music_extension("Display title pt. 2", "audio/mp4", "").as_deref(), Some("m4a"));
+    assert_eq!(music_extension("Unknown", "", "audio"), None);
+    assert_eq!(music_extension("Video.mp4", "video/mp4", ""), None);
+}
+
+fn audio_mime(ext: &str, mime: &str, file_type: &str) -> String {
+    match ext {
+        "flac" => "audio/x-flac",
+        "mp3" => "audio/mpeg",
+        "m4a" | "m4b" | "alac" => "audio/mp4",
+        "aac" => "audio/aac",
+        "ogg" | "oga" | "opus" => "audio/ogg",
+        "wav" => "audio/wav",
+        "aif" | "aiff" => "audio/aiff",
+        "mka" => "audio/x-matroska",
+        "wma" => "audio/x-ms-wma",
+        _ => [mime, file_type].into_iter().find(|value| value.starts_with("audio/"))
+            .unwrap_or("application/octet-stream"),
+    }.to_string()
 }
 
